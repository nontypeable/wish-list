{$SITE_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 10MB
    }

    header X-Content-Type-Options nosniff

    handle_path /static/* {
        root * /srv/wish/static
        file_server
    }

    # Photos are private: Django checks wishlist ownership/invitation access.
    handle /media/* {
        header Content-Security-Policy "default-src 'none'; sandbox"
        reverse_proxy web:8000
    }

    handle {
        reverse_proxy web:8000
    }
}
