SITE_DOMAIN=wish.example.com
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=wish.example.com
CSRF_TRUSTED_ORIGINS=https://wish.example.com

TRUST_PROXY_HEADERS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600

DATABASE_PATH=/var/lib/wish/data/db.sqlite3
MEDIA_ROOT=/var/lib/wish/media
STATIC_ROOT=/var/lib/wish/static

GUNICORN_WORKERS=1
GUNICORN_THREADS=2

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_USE_SSL=False
DEFAULT_FROM_EMAIL=wish@wish.example.com
